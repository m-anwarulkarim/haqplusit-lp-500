---
// Footer.astro - Clean, Premium Light Footer
const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-slate-200 pt-16 pb-12 text-slate-600">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-slate-200"
    >
      <!-- Brand & Mission -->
      <div class="md:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div
            class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold font-['Space_Grotesk'] text-lg shadow-sm"
          >
            H+
          </div>
          <div>
            <span
              class="text-xl font-bold tracking-tight text-slate-900 font-['Space_Grotesk']"
            >
              HaqPlus <span class="text-blue-600">IT</span>
            </span>
            <span class="block text-xs text-slate-500"
              >Software & Digital Agency</span
            >
          </div>
        </a>
        <p class="text-sm text-slate-500 max-w-md leading-relaxed">
          আমরা তৈরি করি দ্রুতগতির ও আধুনিক ওয়েব অ্যাপ্লিকেশন, মোবাইল অ্যাপ এবং
          ই-কমার্স সলিউশন যা আপনার ব্যবসাকে এগিয়ে নিয়ে যায়।
        </p>
        <div
          class="flex items-center gap-2 text-xs font-semibold text-slate-700"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Dhaka, Bangladesh • Serving Global & Domestic Clients</span>
        </div>
      </div>

      <!-- Quick Services -->
      <div>
        <h4
          class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3"
        >
          Our Core Services
        </h4>
        <ul class="space-y-2 text-sm text-slate-500">
          <li>E-Commerce & Online Store</li>
          <li>Landing Page Design</li>
          <li>Custom Web & SaaS Apps</li>
          <li>Mobile App (iOS & Android)</li>
        </ul>
      </div>

      <!-- Direct Contact -->
      <div>
        <h4
          class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3"
        >
          Contact & Support
        </h4>
        <ul class="space-y-2 text-sm text-slate-500">
          <li>
            <a
              href="https://wa.me/8801560007230"
              target="_blank"
              class="hover:text-blue-600 flex items-center gap-2 font-medium text-emerald-700"
            >
              <svg
                class="w-4 h-4 text-emerald-600 fill-current"
                viewBox="0 0 24 24"
                ><path
                  d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"
                ></path></svg
              >
              <span>WhatsApp: 01560-007230</span>
            </a>
          </li>
          <li>
            <a
              href="tel:01560007230"
              class="hover:text-blue-600 flex items-center gap-2 font-medium text-slate-700"
            >
              <svg
                class="w-4 h-4 text-blue-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path></svg
              >
              <span>সরাসরি কল: 01560-007230</span>
            </a>
          </li>
          <li>
            <a
              href="mailto:dev.anwarul@gmail.com"
              class="hover:text-blue-600 flex items-center gap-2"
            >
              <svg
                class="w-4 h-4 text-slate-500"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path></svg
              >
              <span>dev.anwarul@gmail.com</span>
            </a>
          </li>
          <li class="text-xs text-slate-400 pt-1">
            ২৪/৭ টেকনিক্যাল সাপোর্ট ও সার্ভিস
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500"
    >
      <div>
        © {currentYear} HaqPlus IT (haqplusit.site). All rights reserved.
      </div>
    </div>
  </div>
</footer>
