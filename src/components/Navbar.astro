---
// Navbar.astro - 100% Responsive, Clean & Modern Header
interface NavLink {
  label: string;
  href: string;
  badge?: string;
}

const WHATSAPP_NUMBER = "8801560007230";
const PHONE_DISPLAY = "01560-007230";
const WHATSAPP_DEFAULT_MSG = encodeURIComponent(
  "হ্যালো HaqPlus IT, আমি ৫০০ টাকার ল্যান্ডিং পেজ নিয়ে আলোচনা করতে চাই।",
);
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_DEFAULT_MSG}`;

const WA_PATH =
  "M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z";

const navLinks: NavLink[] = [
  { label: "ফিচার", href: "#features" },
  { label: "প্রক্রিয়া", href: "#process" },
  { label: "প্যাকেজ ও রেট", href: "#packages" },
  { label: "প্রশ্নোত্তর", href: "#faq" },
];
---

<header
  id="main-navbar"
  class="sticky top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 transition-all duration-200"
>
  <div class="max-w-6xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- ১. Logo & Brand (Never wraps, compact on mobile) -->
      <a
        href="/"
        class="flex items-center gap-2.5 sm:gap-3 group focus:outline-none shrink-0"
        aria-label="HaqPlus IT হোম"
      >
        <span
          class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-blue-700 text-white font-extrabold text-base sm:text-lg shadow-sm shadow-blue-500/25 shrink-0 group-hover:scale-105 transition-transform"
        >
          H+
        </span>
        <span class="flex flex-col leading-tight">
          <span class="flex items-center gap-2">
            <span
              class="text-base sm:text-xl font-extrabold tracking-tight text-slate-900 font-['Space_Grotesk'] whitespace-nowrap"
            >
              HaqPlus <span class="text-blue-600">IT</span>
            </span>
            <!-- Available Pill: Hidden on mobile, visible on desktop -->
            <span
              class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80 whitespace-nowrap"
            >
              <span
                class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse mr-1"
              ></span>
              Available
            </span>
          </span>
          <!-- Subtitle: Hidden on mobile, visible on desktop -->
          <span
            class="hidden sm:block text-[11px] font-medium text-slate-500 tracking-wide whitespace-nowrap"
          >
            Software & Digital Agency
          </span>
        </span>
      </a>

      <!-- ২. Desktop Navigation Links (Tablet & Desktop) -->
      <nav
        class="hidden md:flex items-center gap-6 lg:gap-8 text-sm font-semibold text-slate-600"
        aria-label="প্রধান মেনু"
      >
        {
          navLinks.map((item) => (
            <a
              href={item.href}
              class="relative py-1 hover:text-blue-600 transition-colors group flex items-center gap-1.5 whitespace-nowrap"
            >
              <span>{item.label}</span>
              {item.badge && (
                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-blue-50 text-blue-600 border border-blue-200/60">
                  {item.badge}
                </span>
              )}
              <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-600 transition-all duration-200 group-hover:w-full" />
            </a>
          ))
        }
      </nav>

      <!-- ৩. Desktop Action Buttons -->
      <div class="hidden sm:flex items-center gap-3 shrink-0">
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-xl border border-emerald-200 transition-all whitespace-nowrap"
        >
          <svg
            class="h-4 w-4 fill-current text-emerald-600 shrink-0"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d={WA_PATH}></path>
          </svg>
          <span>WhatsApp Chat</span>
        </a>

        <a
          href="#book-landing-page"
          class="px-4 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-xs hover:shadow-md hover:shadow-blue-500/20 active:scale-95 transition-all whitespace-nowrap"
        >
          অর্ডার বুক করুন
        </a>
      </div>

      <!-- ৪. Mobile Action Group (Ultra Compact, Never Wraps, 100% Fits Any Screen) -->
      <div class="flex sm:hidden items-center gap-1.5 shrink-0">
        <!-- WhatsApp Icon (Compact) -->
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-200/80 flex items-center justify-center active:scale-90 transition-transform shrink-0"
          aria-label="WhatsApp মেসেজ"
          title="WhatsApp Chat"
        >
          <svg
            class="w-4 h-4 fill-current"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d={WA_PATH}></path>
          </svg>
        </a>

        <!-- Quick Order Button (Compact, Single-Line, Never Wraps) -->
        <a
          href="#book-landing-page"
          class="px-2.5 py-1.5 rounded-xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 active:scale-95 transition-transform whitespace-nowrap shadow-xs shrink-0"
        >
          অর্ডার করুন
        </a>

        <!-- Hamburger Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="w-9 h-9 rounded-xl border border-slate-200/80 text-slate-700 hover:bg-slate-100 flex items-center justify-center active:scale-90 transition-transform shrink-0 cursor-pointer focus:outline-none"
          aria-label="মেনু খুলুন"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            id="menu-open-icon"
            class="w-5 h-5 block"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="menu-close-icon"
            class="w-5 h-5 hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ৫. Mobile Dropdown Menu Drawer -->
  <div
    id="mobile-menu"
    class="hidden sm:hidden border-t border-slate-200 bg-white/98 backdrop-blur-xl px-4 pt-3 pb-6 shadow-2xl transition-all"
  >
    <nav class="flex flex-col space-y-1">
      {
        navLinks.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-bold text-slate-800 hover:bg-blue-50 hover:text-blue-600 transition-colors"
          >
            <span>{item.label}</span>
            {item.badge && (
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-blue-50 text-blue-600 border border-blue-200/60">
                {item.badge}
              </span>
            )}
          </a>
        ))
      }

      <div class="pt-3 mt-2 border-t border-slate-100 flex flex-col gap-2">
        <a
          href={WHATSAPP_URL}
          target="_blank"
          class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl text-xs font-bold text-emerald-800 bg-emerald-50 border border-emerald-200"
        >
          <svg class="w-4 h-4 text-emerald-600 fill-current" viewBox="0 0 24 24"
            ><path
              d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"
            ></path></svg
          >
          <span>WhatsApp: {PHONE_DISPLAY}</span>
        </a>
        <a
          href="tel:01560007230"
          class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200"
        >
          <svg
            class="w-4 h-4 text-blue-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path></svg
          >
          <span>সরাসরি কল: {PHONE_DISPLAY}</span>
        </a>
        <a
          href="#book-landing-page"
          class="mobile-nav-link w-full py-3 text-center text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm mt-1"
        >
          মাত্র ৫০০ টাকায় অর্ডার করুন
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const setupNavbar = () => {
    const navbar = document.getElementById("main-navbar");
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const openIcon = document.getElementById("menu-open-icon");
    const closeIcon = document.getElementById("menu-close-icon");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    if (!navbar || !menuBtn || !mobileMenu) return;

    const toggleMenu = () => {
      const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", String(!isExpanded));
      mobileMenu.classList.toggle("hidden");
      openIcon?.classList.toggle("hidden");
      closeIcon?.classList.toggle("hidden");
    };

    menuBtn.onclick = (e) => {
      e.stopPropagation();
      toggleMenu();
    };

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (!mobileMenu.classList.contains("hidden")) {
          toggleMenu();
        }
      });
    });

    document.addEventListener("click", (e) => {
      if (
        !mobileMenu.classList.contains("hidden") &&
        !mobileMenu.contains(e.target as Node) &&
        !menuBtn.contains(e.target as Node)
      ) {
        toggleMenu();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !mobileMenu.classList.contains("hidden")) {
        toggleMenu();
      }
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupNavbar);
  } else {
    setupNavbar();
  }
  document.addEventListener("astro:page-load", setupNavbar);
</script>
