---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";

export const prerender = false;
---

<Layout
  title="ধন্যবাদ! আপনার অর্ডার সফলভাবে গৃহীত হয়েছে | HaqPlus IT"
  description="হক প্লাস আইটি প্রচার অফারে অর্ডার করার জন্য ধন্যবাদ। আমাদের টিম শীঘ্রই যোগাযোগ করবে।"
>
  <Navbar />

  <main class="min-h-[80vh] bg-slate-50 py-12 sm:py-20 px-4 sm:px-6 lg:px-8 flex items-center justify-center font-['Hind_Siliguri',sans-serif]">
    <div class="max-w-2xl w-full mx-auto">
      
      <!-- Main Thank You Card -->
      <div class="bg-white rounded-3xl border border-slate-200/90 p-6 sm:p-10 shadow-xl shadow-slate-200/50 text-center relative overflow-hidden">
        
        <!-- Subtle Top Glow -->
        <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Success Checkmark Icon -->
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-3xl bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center mx-auto mb-6 shadow-sm">
          <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <!-- Scarcity Confirmation Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold mb-3">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>প্রচার অফার কনফার্মড • আপনার কোটা সংরক্ষিত হয়েছে</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-['Space_Grotesk']">
          ধন্যবাদ! আপনার রিকোয়েস্ট সফলভাবে গৃহীত হয়েছে
        </h1>

        <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed max-w-lg mx-auto">
          আমরা আপনার বুকিংটি পেয়েছি। হক প্লাস আইটি টিম আপনার প্রোডাক্টের জন্য হাই-কনভার্টিং ল্যান্ডিং পেজ প্রস্তুত করতে দ্রুত যোগাযোগ করবে।
        </p>

        <!-- Order Summary Box -->
        <div class="mt-8 p-5 sm:p-6 rounded-2xl bg-slate-50 border border-slate-200/80 text-left space-y-3.5">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">অর্ডার সারসংক্ষেপ</span>
            <span id="ty-order-id" class="text-xs font-mono font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-md border border-blue-100">
              #HP-500
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div>
              <span class="text-slate-400 block mb-0.5">কাস্টমারের নাম:</span>
              <span id="ty-name" class="font-bold text-slate-800 text-sm">সম্মানিত উদ্যোক্তা</span>
            </div>

            <div>
              <span class="text-slate-400 block mb-0.5">মোবাইল নম্বর:</span>
              <span id="ty-phone" class="font-bold text-slate-800 font-mono text-sm">01XXXXXXXXX</span>
            </div>

            <div>
              <span class="text-slate-400 block mb-0.5">সিলেক্টেড প্যাকেজ:</span>
              <span class="font-bold text-emerald-700">৳৫০০ — অল-ইন-ওয়ান ল্যান্ডিং পেজ</span>
            </div>

            <div>
              <span class="text-slate-400 block mb-0.5">পেমেন্ট স্ট্যাটাস:</span>
              <span class="font-bold text-slate-700">ডেমো দেখার পর পেমেন্ট (কোনো অগ্রিম নেই)</span>
            </div>
          </div>
        </div>

        <!-- 3 Simple Next Steps -->
        <div class="mt-8 text-left space-y-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">পরবর্তী ধাপসমূহ:</h3>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-sm">
              <div class="w-6 h-6 rounded-full bg-blue-50 text-blue-600 font-bold text-xs flex items-center justify-center font-mono mb-2">1</div>
              <div class="text-xs font-bold text-slate-800 mb-0.5">কল / WhatsApp</div>
              <p class="text-[11px] text-slate-500 leading-relaxed">আমাদের প্রতিনিধি আপনার সাথে যোগাযোগ করে প্রোডাক্ট ডিটেইলস জেনে নেবে।</p>
            </div>

            <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-sm">
              <div class="w-6 h-6 rounded-full bg-blue-50 text-blue-600 font-bold text-xs flex items-center justify-center font-mono mb-2">2</div>
              <div class="text-xs font-bold text-slate-800 mb-0.5">ডেমো তৈরি</div>
              <p class="text-[11px] text-slate-500 leading-relaxed">আপনার প্রোডাক্টের জন্য প্রিমিয়াম ডিজাইন ও সেলস ফানেল তৈরি করা হবে।</p>
            </div>

            <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-sm">
              <div class="w-6 h-6 rounded-full bg-blue-50 text-blue-600 font-bold text-xs flex items-center justify-center font-mono mb-2">3</div>
              <div class="text-xs font-bold text-slate-800 mb-0.5">ডেলিভারি ও সেটআপ</div>
              <p class="text-[11px] text-slate-500 leading-relaxed">ডেমো দেখে সন্তুষ্ট হলে Pixel, CAPI এবং Courier কানেক্ট করে দেওয়া হবে।</p>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3">
          <!-- WhatsApp Quick Chat -->
          <a
            id="ty-whatsapp-link"
            href="https://wa.me/8801560007230"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 py-3 px-6 rounded-xl font-bold text-xs sm:text-sm text-white bg-emerald-600 hover:bg-emerald-700 shadow-md shadow-emerald-600/20 transition-all cursor-pointer"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>সরাসরি WhatsApp-এ কথা বলুন</span>
          </a>

          <!-- Direct Call -->
          <a
            href="tel:01560007230"
            class="flex items-center justify-center gap-2 py-3 px-6 rounded-xl font-bold text-xs sm:text-sm text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-all cursor-pointer"
          >
            <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>সরাসরি কল দিন (01560-007230)</span>
          </a>

          <!-- Return Home -->
          <a
            href="/"
            class="flex items-center justify-center py-3 px-5 rounded-xl font-medium text-xs sm:text-sm text-slate-500 hover:text-slate-900 transition-colors"
          >
            হোমপেজে ফিরে যান
          </a>
        </div>

      </div>

    </div>
  </main>

  <Footer />
  <FloatingWhatsApp />

  <!-- Client-side script to populate query params and trigger Conversion Events -->
  <script>
    function parseQuery() {
      const params = new URLSearchParams(window.location.search);
      const name = params.get("name") || "সম্মানিত উদ্যোক্তা";
      const phone = params.get("phone") || "01560-007230";
      const product = params.get("product") || "ই-কমার্স ল্যান্ডিং পেজ";

      const nameEl = document.getElementById("ty-name");
      const phoneEl = document.getElementById("ty-phone");
      const waLink = document.getElementById("ty-whatsapp-link") as HTMLAnchorElement | null;
      const orderIdEl = document.getElementById("ty-order-id");

      if (nameEl) nameEl.textContent = name;
      if (phoneEl) phoneEl.textContent = phone;

      // Random clean Order ID like #HP-51945
      const randomId = Math.floor(51900 + Math.random() * 99);
      if (orderIdEl) orderIdEl.textContent = `#HP-${randomId}`;

      if (waLink) {
        const msg = encodeURIComponent(
          `আসসালামু আলাইকুম HaqPlus IT, আমি ৫০০ টাকার ল্যান্ডিং পেজের অর্ডার বুক করেছি।\nনাম: ${name}\nফোন: ${phone}\nপ্রোডাক্ট: ${product}`
        );
        waLink.href = `https://wa.me/8801560007230?text=${msg}`;
      }

      // Track standard Lead / Purchase event if FB pixel is installed
      if (typeof window !== "undefined" && (window as any).fbq) {
        (window as any).fbq("track", "Lead", {
          content_name: "Landing Page 500 Taka Offer",
          value: 500,
          currency: "BDT"
        });
      }
    }

    document.addEventListener("astro:page-load", parseQuery);
    if (document.readyState === "complete" || document.readyState === "interactive") {
      parseQuery();
    }
  </script>
</Layout>
