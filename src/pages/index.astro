  <FloatingWhatsApp />

  <script>
    const WA_NUMBER = "8801560007230";
    const BN_DIGITS = "০১২৩৪৫৬৭৮৯";
    const toEnglishDigits = (s: string) =>
      s.replace(/[০-৯]/g, (d) => String(BN_DIGITS.indexOf(d)));

    function initLeadForm() {
      const form = document.getElementById(
        "lead-form",
      ) as HTMLFormElement | null;
      if (!form || form.dataset.bound === "1") return;
      form.dataset.bound = "1";

      const wrap = document.getElementById("lead-form-wrap");
      const success = document.getElementById("lead-success");
      const successMsg = document.getElementById("lead-success-msg");
      const successWa = document.getElementById(
        "lead-success-wa",
      ) as HTMLAnchorElement | null;
      const resetBtn = document.getElementById("lead-reset");
      const submitBtn = document.getElementById(
        "lead-submit",
      ) as HTMLButtonElement | null;
      const btnText = document.getElementById("lead-submit-text");
      const spinner = document.getElementById("lead-spinner");
      const errorBox = document.getElementById("lead-error");
      const pkgSelect = document.getElementById(
        "lead-package",
      ) as HTMLSelectElement | null;

      const showError = (msg: string) => {
        if (!errorBox) return;
        errorBox.textContent = msg;
        errorBox.classList.remove("hidden");
      };
      const clearError = () => errorBox?.classList.add("hidden");

      // প্যাকেজ বাটনে ক্লিক করলে ফর্মে সেই প্যাকেজ সিলেক্ট হবে
      document
        .querySelectorAll<HTMLElement>("[data-select-package]")
        .forEach((el) => {
          el.addEventListener("click", () => {
            const value = el.dataset.selectPackage;
            if (pkgSelect && value) pkgSelect.value = value;
          });
        });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearError();

        const fd = new FormData(form);
        const name = (fd.get("fullName") ?? "").toString().trim();
        const rawPhone = toEnglishDigits(
          (fd.get("phone") ?? "").toString().trim(),
        );
        const phone = rawPhone.replace(/[\s-]/g, "").replace(/^\+?88/, "");
        const product =
          (fd.get("product") ?? "").toString().trim() || "উল্লেখ করা হয়নি";
        const pkg = (fd.get("package") ?? "").toString();

        if (name.length < 2) return showError("অনুগ্রহ করে আপনার নাম লিখুন।");
        if (!/^01[3-9]\d{8}$/.test(phone))
          return showError(
            "সঠিক ১১ সংখ্যার মোবাইল নম্বর দিন (যেমন: 01XXXXXXXXX)।",
          );

        const now = new Date();
        const leadData = {
          fullName: name,
          phone,
          email: "",
          service: "ই-কমার্স ল্যান্ডিং পেজ (৳৫০০ অফার)",
          budget: pkg,
          message: `Product/Business: ${product} | Selected Package: ${pkg}`,
          source: "Landing Page 500 Taka Campaign",
          createdAt: now.toISOString(),
          formattedDate: now.toLocaleString("en-US", {
            timeZone: "Asia/Dhaka",
          }),
        };

        if (submitBtn && btnText && spinner) {
          submitBtn.disabled = true;
          btnText.textContent = "প্রসেস হচ্ছে...";
          spinner.classList.remove("hidden");
        }

        let saved = false;
        try {
          const res = await fetch("/api/lead", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(leadData),
          });
          saved = res.ok;
        } catch {
          saved = false;
        }

        if (submitBtn && btnText && spinner) {
          submitBtn.disabled = false;
          btnText.textContent = "অর্ডার কনফার্ম করুন";
          spinner.classList.add("hidden");
        }

        const waText = encodeURIComponent(
          `*নতুন ল্যান্ডিং পেজ অর্ডার*\nনাম: ${name}\nফোন: ${phone}\nপ্রোডাক্ট/পেজ: ${product}\nপ্যাকেজ: ${pkg}`,
        );
        if (successWa)
          successWa.href = `https://wa.me/${WA_NUMBER}?text=${waText}`;
        if (successMsg)
          successMsg.textContent = saved
            ? `ধন্যবাদ ${name}! আপনার রিকোয়েস্ট জমা হয়েছে। আমরা ${phone} নম্বরে যোগাযোগ করব।`
            : `ধন্যবাদ ${name}! সার্ভারে সংযোগ হয়নি, তাই নিচের বাটনে চাপ দিয়ে WhatsApp-এ তথ্যটি পাঠিয়ে দিন।`;

        wrap?.classList.add("hidden");
        success?.classList.remove("hidden");
        form.reset();
        if (pkgSelect) pkgSelect.selectedIndex = 0;

        // Redirect to dedicated Thank You page
        setTimeout(() => {
          const redirectUrl = `/thank-you?name=${encodeURIComponent(name)}&phone=${encodeURIComponent(phone)}&product=${encodeURIComponent(product)}`;
          window.location.href = redirectUrl;
        }, 600);
      });

      resetBtn?.addEventListener("click", () => {
        success?.classList.add("hidden");
        wrap?.classList.remove("hidden");
      });
    }

    document.addEventListener("astro:page-load", initLeadForm);
  </script>
