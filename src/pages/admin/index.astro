---
import Layout from "../../layouts/Layout.astro";
import { getAllLeads } from "../../lib/leadsStorage";

export const prerender = false;

// Initial SSR fetch of leads
const initialLeads = await getAllLeads();
---

<Layout
  title="Orders | HaqPlus IT OMS"
  description="Clean & Professional Order Management System for HaqPlus IT"
>
  <div
    class="min-h-screen bg-[#F6F8FA] text-slate-800 font-sans selection:bg-purple-600 selection:text-white flex flex-col pb-20 lg:pb-0"
  >
    <!-- Mobile Backdrop -->
    <div
      id="sidebar-backdrop"
      class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm hidden lg:hidden transition-opacity"
    >
    </div>

    <!-- LEFT SIDEBAR (Desktop Dock & Mobile Slide-Out Drawer) -->
    <aside
      id="admin-sidebar"
      class="fixed inset-y-0 left-0 z-50 w-64 bg-white border-r border-slate-200/90 flex flex-col justify-between transition-transform duration-300 transform -translate-x-full lg:translate-x-0 shadow-xl lg:shadow-none"
    >
      <div
        class="flex flex-col flex-1 overflow-y-auto scrollbar-thin scrollbar-thumb-slate-200"
      >
        <!-- Brand Header with Logo & Collapse Toggle -->
        <div
          class="h-16 lg:h-20 px-5 border-b border-slate-100 flex items-center justify-between"
        >
          <a href="/admin" class="flex items-center gap-3 group">
            <div
              class="w-9 h-9 lg:w-10 lg:h-10 rounded-2xl bg-gradient-to-tr from-purple-600 to-indigo-600 flex items-center justify-center font-bold text-white font-['Space_Grotesk'] text-base lg:text-lg shadow-md shadow-purple-500/25"
            >
              H+
            </div>
            <div>
              <div
                class="text-sm lg:text-base font-bold text-slate-900 tracking-tight font-['Space_Grotesk']"
              >
                HaqPlus IT
              </div>
              <div class="text-[10px] lg:text-[11px] text-slate-400 font-medium">
                Order Management
              </div>
            </div>
          </a>

          <!-- Mobile Close / Desktop Toggle Button -->
          <button
            type="button"
            id="close-sidebar-btn"
            class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-colors cursor-pointer text-xs"
            title="Close Menu"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Sidebar Navigation -->
        <nav class="p-4 space-y-1.5">
          <!-- 1. Dashboard -->
          <button
            type="button"
            id="sb-dash-btn"
            class="w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-xs font-semibold text-slate-600 hover:text-purple-700 hover:bg-purple-50/60 transition-all text-left group cursor-pointer"
          >
            <svg
              class="w-4 h-4 text-slate-400 group-hover:text-purple-600 transition-colors"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
              ></path>
            </svg>
            <span>Dashboard</span>
          </button>

          <!-- 2. Orders (ACTIVE PURPLE MENU) -->
          <div class="space-y-1">
            <button
              type="button"
              class="w-full flex items-center justify-between px-4 py-3 rounded-xl text-xs font-bold text-white bg-purple-600 shadow-md shadow-purple-600/25 transition-all text-left"
            >
              <div class="flex items-center gap-3.5">
                <svg
                  class="w-4 h-4 text-white"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
                <span>Orders</span>
              </div>
              <svg
                class="w-3.5 h-3.5 text-white/80"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>

            <!-- Submenu -->
            <div class="pl-11 pr-2 py-1 space-y-1 text-xs">
              <button
                type="button"
                data-sidebar-status="all"
                class="sidebar-nav-btn w-full text-left py-1.5 px-2 rounded-lg font-bold text-purple-700 bg-purple-50/80 flex items-center justify-between cursor-pointer"
              >
                <span>• All Orders</span>
                <span
                  id="sb-count-all"
                  class="text-[10px] bg-purple-200/70 text-purple-800 px-1.5 py-0.2 rounded font-mono"
                  >{initialLeads.length}</span
                >
              </button>
              <button
                type="button"
                data-sidebar-status="new"
                class="sidebar-nav-btn w-full text-left py-1.5 px-2 rounded-lg font-medium text-slate-500 hover:text-purple-700 hover:bg-slate-50 transition-colors flex items-center justify-between cursor-pointer"
              >
                <span>• New Orders</span>
                <span
                  id="sb-count-new"
                  class="text-[10px] bg-rose-100 text-rose-700 px-1.5 py-0.2 rounded font-mono font-bold"
                  >{initialLeads.filter((l) => l.status === "new").length}</span
                >
              </button>
              <button
                type="button"
                data-sidebar-status="won"
                class="sidebar-nav-btn w-full text-left py-1.5 px-2 rounded-lg font-medium text-slate-500 hover:text-purple-700 hover:bg-slate-50 transition-colors flex items-center justify-between cursor-pointer"
              >
                <span>• Confirmed / Paid</span>
                <span
                  id="sb-count-won"
                  class="text-[10px] bg-emerald-100 text-emerald-700 px-1.5 py-0.2 rounded font-mono"
                  >{initialLeads.filter((l) => l.status === "won").length}</span
                >
              </button>
              <button
                type="button"
                data-sidebar-status="cancelled"
                class="sidebar-nav-btn w-full text-left py-1.5 px-2 rounded-lg font-medium text-slate-500 hover:text-purple-700 hover:bg-slate-50 transition-colors flex items-center justify-between cursor-pointer"
              >
                <span>• Cancelled Orders</span>
                <span
                  id="sb-count-cancelled"
                  class="text-[10px] bg-slate-100 text-slate-600 px-1.5 py-0.2 rounded font-mono"
                  >{
                    initialLeads.filter((l) => l.status === "cancelled").length
                  }</span
                >
              </button>
            </div>
          </div>

          <!-- 3. Products -->
          <button
            type="button"
            id="sb-products-btn"
            class="w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-xs font-semibold text-slate-600 hover:text-purple-700 hover:bg-purple-50/60 transition-all group text-left cursor-pointer"
          >
            <svg
              class="w-4 h-4 text-slate-400 group-hover:text-purple-600 transition-colors"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
              ></path>
            </svg>
            <span>Products</span>
          </button>

          <!-- 4. Settings & Courier -->
          <button
            type="button"
            id="open-courier-modal-btn"
            class="w-full flex items-center justify-between px-4 py-3 rounded-xl text-xs font-semibold text-slate-600 hover:text-purple-700 hover:bg-purple-50/60 transition-all group cursor-pointer"
          >
            <div class="flex items-center gap-3.5">
              <svg
                class="w-4 h-4 text-slate-400 group-hover:text-purple-600 transition-colors"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span>Settings & Courier</span>
            </div>
            <span
              class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold"
              >API</span
            >
          </button>

          <!-- 5. Landing Page -->
          <a
            href="/"
            target="_blank"
            class="flex items-center justify-between px-4 py-3 rounded-xl text-xs font-semibold text-slate-600 hover:text-purple-700 hover:bg-purple-50/60 transition-all group"
          >
            <div class="flex items-center gap-3.5">
              <svg
                class="w-4 h-4 text-slate-400 group-hover:text-purple-600 transition-colors"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              <span>Landing Page</span>
            </div>
            <span class="text-slate-400 text-xs">↗</span>
          </a>

          <!-- 6. Scarcity Box -->
          <div
            class="px-4 py-3 rounded-xl bg-purple-50/70 border border-purple-100 text-xs mt-3"
          >
            <div
              class="flex items-center justify-between text-purple-900 font-bold mb-1"
            >
              <span>Daily Target (5 Limit)</span>
              <span class="text-[11px] font-mono text-purple-700">3/5</span>
            </div>
            <div
              class="w-full h-1.5 rounded-full bg-purple-200 overflow-hidden"
            >
              <div class="w-3/5 h-full bg-purple-600 rounded-full"></div>
            </div>
            <p class="text-[10px] text-purple-600/80 mt-1.5 font-medium">
              হক প্লাস আইটি প্রচার অফার
            </p>
          </div>
        </nav>
      </div>

      <!-- Bottom Profile & Logout -->
      <div class="p-4 border-t border-slate-100 bg-slate-50/60">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2.5 overflow-hidden">
            <div
              class="w-9 h-9 rounded-xl bg-purple-100 border border-purple-200 text-purple-700 font-bold flex items-center justify-center font-['Space_Grotesk'] text-xs shrink-0"
            >
              AK
            </div>
            <div class="overflow-hidden">
              <div class="text-xs font-bold text-slate-800 truncate">
                Anwarul Karim
              </div>
              <div class="text-[10px] text-slate-400 truncate">
                01560-007230
              </div>
            </div>
          </div>

          <button
            type="button"
            id="auth-logout-btn"
            class="w-8 h-8 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center transition-colors cursor-pointer"
            title="লগআউট"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </aside>

    <!-- RIGHT MAIN CONTENT CANVAS -->
    <div class="lg:pl-64 flex-1 flex flex-col min-w-0">
      
      <!-- TOP HEADER BAR (Mobile Matching Screenshot with Left Logo & Right Icons) -->
      <header
        class="h-16 lg:h-18 px-4 sm:px-8 bg-white border-b border-slate-200/80 flex items-center justify-between gap-3 sticky top-0 z-30"
      >
        <!-- Left: Logo & Title -->
        <div class="flex items-center gap-2.5 sm:gap-3">
          <a href="/admin" class="flex items-center gap-2 group">
            <div
              class="w-9 h-9 rounded-xl bg-gradient-to-tr from-purple-600 to-indigo-600 flex items-center justify-center font-bold text-white font-['Space_Grotesk'] text-sm shadow-md shadow-purple-500/25"
            >
              H+
            </div>
            <div class="flex flex-col">
              <span class="text-sm font-bold text-slate-900 font-['Space_Grotesk'] leading-tight">
                HaqPlus IT
              </span>
              <span class="text-[10px] text-slate-400 font-medium leading-none">
                OMS Portal
              </span>
            </div>
          </a>

          <!-- Desktop Title Separator -->
          <div class="hidden lg:flex items-center gap-3 pl-4 border-l border-slate-200">
            <h1 class="text-xl font-bold text-slate-900 font-['Space_Grotesk'] tracking-tight">
              Order
            </h1>
          </div>
        </div>

        <!-- Right: Actions & Tools Matching Screenshot Exactly -->
        <div class="flex items-center gap-1.5 sm:gap-2.5">
          
          <!-- Headset Support (Purple Square/Pill with Headset Icon) -->
          <a
            href="https://wa.me/8801560007230"
            target="_blank"
            class="w-9 h-9 sm:w-auto sm:px-3.5 sm:py-2 rounded-xl bg-purple-600 hover:bg-purple-700 text-white flex items-center justify-center gap-2 shadow-md shadow-purple-500/20 transition-all"
            title="Customer Support"
          >
            <svg
              class="w-4 h-4 fill-none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z"
              ></path>
            </svg>
            <span class="hidden sm:inline text-xs font-bold">Support</span>
          </a>

          <!-- Globe Circle Button -->
          <button
            type="button"
            class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white border border-slate-200/80 hover:bg-slate-50 text-slate-600 flex items-center justify-center transition-colors"
            title="Language"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
              ></path>
            </svg>
          </button>

          <!-- Translate Circle Button -->
          <button
            type="button"
            class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white border border-slate-200/80 hover:bg-slate-50 text-slate-600 flex items-center justify-center transition-colors"
            title="Translation"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
          </button>

          <!-- Search Circle Button -->
          <button
            type="button"
            id="mobile-search-toggle-btn"
            class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white border border-slate-200/80 hover:bg-slate-50 text-slate-600 flex items-center justify-center transition-colors cursor-pointer"
            title="Search Orders"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              ></path>
            </svg>
          </button>

          <!-- Avatar Circle Button -->
          <div
            class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-slate-900 text-white font-bold text-xs flex items-center justify-center font-['Space_Grotesk'] border-2 border-purple-600 cursor-pointer"
            title="Anwarul Karim"
          >
            AK
          </div>

        </div>
      </header>

      <!-- MAIN BODY CONTAINER -->
      <main class="flex-1 p-3.5 sm:p-7 space-y-4 sm:space-y-5 max-w-[1600px] w-full mx-auto">
        
        <!-- TOOLBAR: Search Bar & Actions -->
        <div
          class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3"
        >
          <!-- Search Bar -->
          <div class="relative flex-1 max-w-md">
            <input
              type="text"
              id="leads-search-input"
              placeholder="Search orders, phone, address..."
              class="w-full pl-10 pr-4 py-2 sm:py-2.5 bg-white border border-slate-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-100 transition-all shadow-sm"
            />
            <svg
              class="w-4 h-4 text-slate-400 absolute left-3.5 top-2.5 sm:top-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              ></path>
            </svg>
          </div>

          <!-- Action Buttons Row -->
          <div class="flex items-center gap-2 flex-wrap">
            <!-- Download All Orders -->
            <button
              type="button"
              id="export-csv-btn"
              class="px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-sky-50 text-sky-700 hover:bg-sky-100 text-xs font-bold border border-sky-100 flex items-center gap-1.5 transition-colors cursor-pointer"
            >
              <svg
                class="w-3.5 h-3.5 text-sky-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                ></path>
              </svg>
              <span>Download Orders</span>
            </button>

            <!-- Sync Courier Status -->
            <button
              type="button"
              id="sync-courier-btn"
              class="px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-sky-50 text-sky-700 hover:bg-sky-100 text-xs font-bold border border-sky-100 flex items-center gap-1.5 transition-colors cursor-pointer"
            >
              <svg
                class="w-3.5 h-3.5 text-sky-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                ></path>
              </svg>
              <span>Sync Courier</span>
            </button>

            <!-- + Add Order Button -->
            <button
              type="button"
              id="open-manual-order-modal-btn"
              class="px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold shadow-md shadow-purple-600/20 flex items-center gap-1.5 transition-all cursor-pointer ml-auto sm:ml-0"
            >
              <span class="text-sm leading-none">+</span>
              <span>Add Order</span>
            </button>
          </div>
        </div>

        <!-- HORIZONTAL STATUS PILLS ROW -->
        <div
          class="flex items-center justify-between gap-3 overflow-x-auto pb-1 scrollbar-none"
        >
          <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
            <!-- All Data -->
            <button
              type="button"
              data-filter-status="all"
              class="status-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold bg-purple-600 text-white shadow-sm flex items-center gap-1.5 transition-all cursor-pointer"
            >
              <span>All Data</span>
              <span
                id="tab-count-all"
                class="px-1.5 py-0.2 rounded-full text-[10px] bg-white/20 font-mono"
                >{initialLeads.length}</span
              >
            </button>

            <!-- New Orders -->
            <button
              type="button"
              data-filter-status="new"
              class="status-filter-btn px-3.5 py-1.5 rounded-full text-xs font-medium text-slate-600 bg-white hover:bg-slate-100 border border-slate-200 flex items-center gap-1.5 transition-all cursor-pointer"
            >
              <span>New</span>
              <span
                id="tab-count-new"
                class="px-1.5 py-0.2 rounded-full text-[10px] bg-rose-100 text-rose-700 font-mono font-bold"
                >{initialLeads.filter((l) => l.status === "new").length}</span
              >
            </button>

            <!-- In Contact -->
            <button
              type="button"
              data-filter-status="contacted"
