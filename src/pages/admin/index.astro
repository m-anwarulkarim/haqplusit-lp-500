        <div class="space-y-3.5 text-xs">
          <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="font-bold text-slate-800 mb-1 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Steadfast Courier API Status</span>
            </div>
            <p class="text-slate-500 text-[11px] leading-relaxed">
              Steadfast API Key ও Secret Key অটো সেটআপ চালু আছে। যেকোনো অর্ডার
              ১-ক্লিকে সরাসরি Steadfast পার্সেল সিস্টেমে সেন্ড করা যাবে।
            </p>
          </div>

          <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="font-bold text-slate-800 mb-1 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span>
              <span>Pathao Courier Merchant API</span>
            </div>
            <p class="text-slate-500 text-[11px] leading-relaxed">
              পাঠাও মার্চেন্ট পোর্টালের Client ID ও Secret দিয়ে অটো অর্ডার
              বুকিং কনফার্মেশন ও ট্র্যাকিং সক্রিয় করা যায়।
            </p>
          </div>
        </div>

        <div class="mt-5 flex justify-end">
          <button
            type="button"
            id="ok-courier-btn"
            class="px-5 py-2 rounded-xl text-xs font-bold bg-purple-600 text-white hover:bg-purple-700 cursor-pointer"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-side script handling auth, live fetching, filters, desktop table & mobile cards rendering -->
  <script>
    import type { Lead } from "../../lib/leadsStorage";

    // Auth credentials
    const ADMIN_EMAIL = "dev.anwarul@gmail.com";
    const ADMIN_PASS = "dev.anwarul";
    const AUTH_STORAGE_KEY = "haqplus_admin_user_session";

    const authModal = document.getElementById("auth-modal");
    const authForm = document.getElementById("auth-form");
    const authEmailInput = document.getElementById(
      "auth-email-input",
    ) as HTMLInputElement | null;
    const authPassInput = document.getElementById(
      "auth-pass-input",
    ) as HTMLInputElement | null;
    const authError = document.getElementById("auth-error");
    const logoutBtn = document.getElementById("auth-logout-btn");

    // Sidebar drawer elements
    const adminSidebar = document.getElementById("admin-sidebar");
    const sidebarBackdrop = document.getElementById("sidebar-backdrop");
    const closeSidebarBtn = document.getElementById("close-sidebar-btn");

    // Modals
    const openCourierModalBtn = document.getElementById(
      "open-courier-modal-btn",
    );
    const courierModal = document.getElementById("courier-modal");
    const closeCourierModal = document.getElementById("close-courier-modal");
    const okCourierBtn = document.getElementById("ok-courier-btn");

    // Table & Mobile list elements
    const leadsTableBody = document.getElementById("leads-table-body");
    const mobileLeadsList = document.getElementById("mobile-leads-list");
    const emptyView = document.getElementById("leads-empty-view");
    const searchInput = document.getElementById(
      "leads-search-input",
    ) as HTMLInputElement | null;
    const exportCsvBtn = document.getElementById("export-csv-btn");
    const resetFilterBtn = document.getElementById("empty-reset-filter-btn");
    const tableShowingCount = document.getElementById("table-showing-count");

    // Counts
    const tabCountAll = document.getElementById("tab-count-all");
    const tabCountNew = document.getElementById("tab-count-new");
    const tabCountContacted = document.getElementById("tab-count-contacted");
    const tabCountWon = document.getElementById("tab-count-won");

    const sbCountAll = document.getElementById("sb-count-all");
    const sbCountNew = document.getElementById("sb-count-new");
    const sbCountWon = document.getElementById("sb-count-won");
    const sbCountCancelled = document.getElementById("sb-count-cancelled");

    // Notes modal
    const notesModal = document.getElementById("notes-modal");
    const notesClientName = document.getElementById("notes-client-name");
    const notesLeadId = document.getElementById(
      "notes-lead-id",
    ) as HTMLInputElement | null;
    const notesTextarea = document.getElementById(
      "notes-textarea",
    ) as HTMLTextAreaElement | null;
    const saveNotesBtn = document.getElementById("save-notes-btn");
    const cancelNotesBtn = document.getElementById("cancel-notes-btn");
    const closeNotesModal = document.getElementById("close-notes-modal");

    // Manual Order modal
    const manualOrderModal = document.getElementById("manual-order-modal");
    const openManualOrderBtn = document.getElementById(
      "open-manual-order-modal-btn",
    );
    const closeManualOrderBtn = document.getElementById(
      "close-manual-order-btn",
    );
    const cancelManualOrderBtn = document.getElementById(
      "cancel-manual-order-btn",
    );
    const manualOrderForm = document.getElementById("manual-order-form");

    // State
    let currentLeads: Lead[] = [];
    let currentFilterStatus = "all";
    let searchQuery = "";

    // Sidebar Mobile Open/Close
    function openSidebar() {
      adminSidebar?.classList.remove("-translate-x-full");
      sidebarBackdrop?.classList.remove("hidden");
    }

    function closeSidebar() {
      adminSidebar?.classList.add("-translate-x-full");
      sidebarBackdrop?.classList.add("hidden");
    }

    if (closeSidebarBtn)
      closeSidebarBtn.addEventListener("click", closeSidebar);
    if (sidebarBackdrop)
      sidebarBackdrop.addEventListener("click", closeSidebar);

    // Bottom Navigation Bar items
    const bnavDashboard = document.getElementById("bnav-dashboard");
    const bnavProduct = document.getElementById("bnav-product");
    const bnavOrders = document.getElementById("bnav-orders");
    const bnavNotify = document.getElementById("bnav-notify");
    const bnavMenu = document.getElementById("bnav-menu");

    if (bnavDashboard) {
      bnavDashboard.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
        setActiveFilter("all");
      });
    }

    if (bnavProduct) {
      bnavProduct.addEventListener("click", () => {
        const productSec = document.getElementById("mobile-top-products-section");
        if (productSec) productSec.scrollIntoView({ behavior: "smooth" });
      });
    }

    if (bnavOrders) {
      bnavOrders.addEventListener("click", () => {
        const list = document.getElementById("mobile-leads-list");
        if (list) list.scrollIntoView({ behavior: "smooth" });
      });
    }

    if (bnavNotify) {
      bnavNotify.addEventListener("click", () => {
        fetchLeads();
      });
    }

    if (bnavMenu) {
      bnavMenu.addEventListener("click", () => {
        openSidebar();
      });
    }

    // Mobile search toggle button in header
    const mobileSearchToggleBtn = document.getElementById("mobile-search-toggle-btn");
    if (mobileSearchToggleBtn && searchInput) {
      mobileSearchToggleBtn.addEventListener("click", () => {
        searchInput.focus();
        searchInput.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    }

    // Courier Modal
    if (openCourierModalBtn)
      openCourierModalBtn.addEventListener("click", () => {
        courierModal?.classList.remove("hidden");
        closeSidebar();
      });
    if (closeCourierModal)
      closeCourierModal.addEventListener("click", () =>
        courierModal?.classList.add("hidden"),
      );
    if (okCourierBtn)
      okCourierBtn.addEventListener("click", () =>
        courierModal?.classList.add("hidden"),
      );

    // Auth logic
    function checkAuth(): boolean {
      const user = localStorage.getItem(AUTH_STORAGE_KEY);
      if (user === ADMIN_EMAIL.toLowerCase()) {
        authModal?.classList.add("hidden");
        return true;
      } else {
        authModal?.classList.remove("hidden");
        return false;
      }
    }

    if (authForm) {
      authForm.addEventListener("submit", (e) => {
        e.preventDefault();
        const email = authEmailInput?.value.trim().toLowerCase();
        const pass = authPassInput?.value;
        if (email === ADMIN_EMAIL.toLowerCase() && pass === ADMIN_PASS) {
          localStorage.setItem(AUTH_STORAGE_KEY, email);
          authModal?.classList.add("hidden");
          authError?.classList.add("hidden");
          fetchLeads();
        } else {
          authError?.classList.remove("hidden");
        }
      });
    }

    if (logoutBtn) {
      logoutBtn.addEventListener("click", () => {
        localStorage.removeItem(AUTH_STORAGE_KEY);
        window.location.reload();
      });
    }

    // Manual Order Modal
    if (openManualOrderBtn)
      openManualOrderBtn.addEventListener("click", () =>
        manualOrderModal?.classList.remove("hidden"),
      );
    if (closeManualOrderBtn)
      closeManualOrderBtn.addEventListener("click", () =>
        manualOrderModal?.classList.add("hidden"),
      );
    if (cancelManualOrderBtn)
      cancelManualOrderBtn.addEventListener("click", () =>
        manualOrderModal?.classList.add("hidden"),
      );

    if (manualOrderForm) {
      manualOrderForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const name = (
          document.getElementById("manual-name") as HTMLInputElement
        )?.value.trim();
        const phone = (
          document.getElementById("manual-phone") as HTMLInputElement
        )?.value.trim();
        const product =
          (
            document.getElementById("manual-product") as HTMLInputElement
          )?.value.trim() || "Custom Product";
        const pkg = (
          document.getElementById("manual-package") as HTMLSelectElement
        )?.value;
        const status = (
          document.getElementById("manual-status") as HTMLSelectElement
        )?.value as Lead["status"];

        try {
          const res = await fetch("/api/lead", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              fullName: name,
              phone: phone,
              service: "ই-কমার্স ল্যান্ডিং পেজ",
              budget: pkg,
              message: product,
              status: status || "new",
              source: "Website",
            }),
          });

          if (res.ok) {
            manualOrderModal?.classList.add("hidden");
            (manualOrderForm as HTMLFormElement).reset();
            fetchLeads();
          }
        } catch (err) {
          console.error("Failed to create manual order:", err);
        }
      });
    }

    // Fetch leads
    async function fetchLeads() {
      try {
        const res = await fetch("/api/lead", { cache: "no-store" });
        if (res.ok) {
          const data = await res.json();
          currentLeads = data.leads || [];
          renderAll();
          updateStats();
        }
      } catch (err) {
        console.error("Failed to fetch leads:", err);
      }
    }

    // Update Counts
    function updateStats() {
      const total = currentLeads.length;
      const newCount = currentLeads.filter((l) => l.status === "new").length;
      const contactedCount = currentLeads.filter(
        (l) => l.status === "contacted",
      ).length;
      const wonCount = currentLeads.filter((l) => l.status === "won").length;
      const cancelledCount = currentLeads.filter(
        (l) => l.status === "cancelled",
      ).length;

      if (tabCountAll) tabCountAll.textContent = total.toString();
      if (tabCountNew) tabCountNew.textContent = newCount.toString();
      if (tabCountContacted)
        tabCountContacted.textContent = contactedCount.toString();
      if (tabCountWon) tabCountWon.textContent = wonCount.toString();

      if (sbCountAll) sbCountAll.textContent = total.toString();
      if (sbCountNew) sbCountNew.textContent = newCount.toString();
      if (sbCountWon) sbCountWon.textContent = wonCount.toString();
      if (sbCountCancelled)
        sbCountCancelled.textContent = cancelledCount.toString();
    }

    // Filter sync
    function setActiveFilter(status: string) {
      currentFilterStatus = status;

      // Status pill buttons
      document.querySelectorAll(".status-filter-btn").forEach((b) => {
        const btnStatus = (b as HTMLElement).dataset.filterStatus;
        if (btnStatus === status) {
          b.className =
            "status-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold bg-purple-600 text-white shadow-sm flex items-center gap-1.5 transition-all cursor-pointer";
        } else {
          b.className =
            "status-filter-btn px-3.5 py-1.5 rounded-full text-xs font-medium text-slate-600 bg-white hover:bg-slate-100 border border-slate-200 flex items-center gap-1.5 transition-all cursor-pointer";
        }
      });

      renderAll();
    }

    document.querySelectorAll(".status-filter-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const status = (btn as HTMLElement).dataset.filterStatus || "all";
        setActiveFilter(status);
      });
    });

    document.querySelectorAll(".sidebar-nav-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const status = (btn as HTMLElement).dataset.sidebarStatus || "all";
        setActiveFilter(status);
        closeSidebar();
      });
    });

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        renderAll();
      });
    }

    // Main render function updating both Desktop Table & Mobile Cards
    function renderAll() {
      const filtered = currentLeads.filter((lead) => {
        const matchesStatus =
          currentFilterStatus === "all" || lead.status === currentFilterStatus;
        const matchesSearch =
          !searchQuery ||
          lead.fullName.toLowerCase().includes(searchQuery) ||
          lead.phone.toLowerCase().includes(searchQuery) ||
          lead.service.toLowerCase().includes(searchQuery) ||
          (lead.budget && lead.budget.toLowerCase().includes(searchQuery)) ||
          lead.message.toLowerCase().includes(searchQuery);

        return matchesStatus && matchesSearch;
      });

      if (tableShowingCount)
        tableShowingCount.textContent = filtered.length.toString();

      if (filtered.length === 0) {
        if (leadsTableBody) leadsTableBody.innerHTML = "";
        if (mobileLeadsList) mobileLeadsList.innerHTML = "";
        emptyView?.classList.remove("hidden");
        return;
      }

      emptyView?.classList.add("hidden");

      renderDesktopTable(filtered);
      renderMobileCards(filtered);
      attachHandlers();
    }

    // 1. RENDER MOBILE CARDS (EXACT MATCH FOR USER SCREENSHOT)
    function renderMobileCards(filtered: Lead[]) {
      if (!mobileLeadsList) return;

      mobileLeadsList.innerHTML = filtered.map((lead, index) => {
        const cleanPhone = lead.phone.replace(/[^0-9+]/g, "");
        const waMsg = encodeURIComponent(
          `আসসালামু আলাইকুম ${lead.fullName}, হক প্লাস আইটি থেকে যোগাযোগ করছি। আপনার ই-কমার্স ল্যান্ডিং পেজের অর্ডারটি পেয়েছি। বিস্তারিত কথা বলার জন্য কখন ফ্রি আছেন?`,
        );
        const waLink = `https://wa.me/${cleanPhone.replace("+", "")}?text=${waMsg}`;

        const shortId =
          lead.id.replace(/[^0-9]/g, "").slice(-5) ||
          (51940 + index).toString();

        let statusBadge = `
          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-600 border border-rose-200 flex items-center gap-1">
            <svg class="w-3 h-3 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Pending</span>
          </span>
        `;
        if (lead.status === "won") {
          statusBadge = `
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center gap-1">
              <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Confirmed</span>
            </span>
          `;
        } else if (lead.status === "contacted") {
          statusBadge = `
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200 flex items-center gap-1">
              <span>Contacted</span>
            </span>
          `;
        }

        return `
          <div class="bg-white rounded-3xl p-4 border border-slate-200/90 shadow-sm space-y-3">
            
            <!-- Top Row: Thumbnail + Info -->
            <div class="flex items-start gap-3">
              <!-- Square thumbnail with Blue Badge 1 on top left, exactly as screenshot -->
              <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-tr from-purple-50 to-indigo-50 border border-slate-200/80 overflow-hidden flex items-center justify-center font-bold text-purple-700 font-['Space_Grotesk'] text-sm shrink-0">
                ${lead.fullName.charAt(0).toUpperCase()}
                <span class="absolute top-0 left-0 w-4 h-4 rounded-full bg-blue-600 text-white text-[9px] font-bold flex items-center justify-center font-mono">
                  1
                </span>
              </div>

              <!-- Order ID, Customer Name, Address -->
              <div class="flex-1 min-w-0">
                <div class="font-bold text-slate-900 text-sm font-['Space_Grotesk']">
                  #${shortId}
                </div>
                <div class="font-bold text-slate-800 text-xs mt-0.5 truncate">
                  ${escapeHtml(lead.fullName)}
                </div>
                <div class="text-[11px] text-slate-400 truncate mt-0.5">
                  ${escapeHtml(lead.message || "E-Commerce Landing Page Package")}
                </div>
              </div>
            </div>

            <!-- Date & Status Row matching screenshot -->
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
              <div class="text-[11px] text-slate-500 font-mono">
                ${escapeHtml(lead.formattedDate || "Recent")}
              </div>
              <div>
                ${statusBadge}
              </div>
            </div>

            <!-- Action Toolbar on Mobile Card -->
            <div class="pt-2 flex items-center justify-between gap-2 border-t border-slate-50">
              <div class="flex items-center gap-2">
                ${cleanPhone ? `
                  <a 
                    href="${waLink}" 
                    target="_blank" 
                    class="w-7 h-7 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center"
                    title="WhatsApp"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
                  </a>
                  <a 
                    href="tel:${cleanPhone}" 
                    class="w-7 h-7 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center"
                    title="Call"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  </a>
                ` : ''}
                <button 
                  type="button" 
                  data-note-lead-id="${lead.id}" 
                  data-client-name="${escapeHtml(lead.fullName)}"
                  data-notes="${escapeHtml(lead.notes || '')}"
                  class="open-notes-btn px-2.5 py-1 rounded-xl bg-purple-50 text-purple-700 text-[10px] font-bold"
                >
                  Notes
                </button>
              </div>

              <!-- Quick Status Selector -->
              <select 
                data-lead-id="${lead.id}" 
                class="lead-status-select px-2 py-1 rounded-xl text-[11px] font-semibold bg-slate-50 border border-slate-200 text-slate-800"
              >
                <option value="new" ${lead.status === "new" ? "selected" : ""}>New</option>
                <option value="contacted" ${lead.status === "contacted" ? "selected" : ""}>Pending</option>
                <option value="won" ${lead.status === "won" ? "selected" : ""}>Confirmed</option>
                <option value="cancelled" ${lead.status === "cancelled" ? "selected" : ""}>Cancelled</option>
              </select>
            </div>

          </div>
        `;
      }).join('');
    }

    // 2. RENDER DESKTOP TABLE
    function renderDesktopTable(filtered: Lead[]) {
      if (!leadsTableBody) return;

      leadsTableBody.innerHTML = filtered
        .map((lead, index) => {
          const cleanPhone = lead.phone.replace(/[^0-9+]/g, "");
          const waMsg = encodeURIComponent(
            `আসসালামু আলাইকুম ${lead.fullName}, হক প্লাস আইটি থেকে যোগাযোগ করছি। আপনার ই-কমার্স ল্যান্ডিং পেজের অর্ডারটি পেয়েছি। বিস্তারিত কথা বলার জন্য কখন ফ্রি আছেন?`,
          );
          const waLink = `https://wa.me/${cleanPhone.replace("+", "")}?text=${waMsg}`;

          const shortId =
            lead.id.replace(/[^0-9]/g, "").slice(-5) ||
            (51940 + index).toString();

          let statusBadge = `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">NEW ORDER</span>`;
          if (lead.status === "contacted") {
            statusBadge = `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">IN CONTACT</span>`;
          } else if (lead.status === "won") {
            statusBadge = `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-50 text-purple-700 border border-purple-200">CONFIRMED</span>`;
          } else if (lead.status === "cancelled") {
            statusBadge = `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200">CANCELLED</span>`;
          }

          return `
          <tr class="hover:bg-[#F9FAFC] transition-colors border-b border-slate-100">
            <td class="py-4 pl-6 pr-2">
              <input type="checkbox" class="rounded border-slate-300 text-purple-600 focus:ring-purple-500 cursor-pointer" />
            </td>
            <td class="py-4 px-3 text-slate-500 font-medium font-mono">${index + 1}</td>
            <td class="py-4 px-3">
              <div class="relative w-11 h-11 rounded-xl bg-slate-100 border border-slate-200 overflow-hidden flex items-center justify-center">
                <div class="w-full h-full bg-gradient-to-tr from-purple-100 to-indigo-100 flex items-center justify-center font-bold text-purple-700 font-['Space_Grotesk'] text-xs">
                  ${lead.fullName.charAt(0).toUpperCase()}
                </div>
                <span class="absolute top-0 right-0 w-4 h-4 rounded-full bg-blue-600 text-white text-[9px] font-bold flex items-center justify-center font-mono">1</span>
              </div>
            </td>
            <td class="py-4 px-4">
              <div class="font-bold text-purple-700 font-['Space_Grotesk'] text-sm tracking-wide">${shortId}</div>
              <div class="mt-1">${statusBadge}</div>
            </td>
            <td class="py-4 px-4">
              <div class="font-bold text-slate-900 text-xs">${escapeHtml(lead.fullName)}</div>
              <div class="text-[11px] text-slate-500 mt-0.5 line-clamp-2 leading-relaxed">${escapeHtml(lead.message || "E-Commerce Landing Page Package")}</div>
            </td>
            <td class="py-4 px-4">
              <div class="flex items-center gap-1.5">
                <a href="tel:${cleanPhone}" class="font-mono text-slate-800 font-semibold text-xs hover:text-purple-600">${escapeHtml(lead.phone || "N/A")}</a>
              </div>
              <div class="flex items-center gap-2 mt-1.5">
                ${cleanPhone ? `
                  <a href="${waLink}" target="_blank" class="w-6 h-6 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
                  </a>
                  <a href="tel:${cleanPhone}" class="w-6 h-6 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  </a>
                ` : ""}
                <button type="button" data-note-lead-id="${lead.id}" data-client-name="${escapeHtml(lead.fullName)}" data-notes="${escapeHtml(lead.notes || "")}" class="open-notes-btn px-2 py-0.5 rounded-md bg-purple-50 text-purple-700 text-[10px] font-bold">Details</button>
              </div>
            </td>
            <td class="py-4 px-4 text-slate-600 font-medium">${escapeHtml(lead.source || "Website")}</td>
            <td class="py-4 px-4 text-slate-500 font-mono text-[11px]">${escapeHtml(lead.formattedDate || "Just Now")}</td>
            <td class="py-4 px-4">
              <div class="font-bold text-slate-700">COD</div>
              <div class="text-[10px] font-bold ${lead.status === "won" ? "text-emerald-600" : "text-rose-600"}">
                ${lead.status === "won" ? "PAID ৳৫০০" : "UNPAID"}
              </div>
            </td>
            <td class="py-4 pr-6 pl-3 text-right">
              <div class="flex items-center justify-end gap-1.5">
                <select data-lead-id="${lead.id}" class="lead-status-select px-2.5 py-1 rounded-xl text-[11px] font-semibold bg-white border border-slate-200 text-slate-800">
                  <option value="new" ${lead.status === "new" ? "selected" : ""}>New</option>
                  <option value="contacted" ${lead.status === "contacted" ? "selected" : ""}>In Contact</option>
                  <option value="won" ${lead.status === "won" ? "selected" : ""}>Confirmed</option>
                  <option value="cancelled" ${lead.status === "cancelled" ? "selected" : ""}>Cancelled</option>
                </select>
                <button type="button" data-delete-lead-id="${lead.id}" class="delete-lead-btn w-7 h-7 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center transition-colors">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </div>
            </td>
          </tr>
        `;
        })
        .join("");
    }

    function escapeHtml(str: string): string {
      return (str || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function attachHandlers() {
      // Status selector change
      document.querySelectorAll(".lead-status-select").forEach((select) => {
        select.addEventListener("change", async (e) => {
          const target = e.target as HTMLSelectElement;
          const id = target.dataset.leadId;
          const status = target.value;
          if (!id) return;

          try {
            await fetch("/api/lead", {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ id, status }),
            });
            const item = currentLeads.find((l) => l.id === id);
            if (item) item.status = status as Lead["status"];
            updateStats();
            renderAll();
          } catch (err) {
            console.error("Failed to update status:", err);
          }
        });
      });

      // Notes modal trigger
      document.querySelectorAll(".open-notes-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = (btn as HTMLElement).dataset.noteLeadId || "";
          const name = (btn as HTMLElement).dataset.clientName || "Client";
          const notes = (btn as HTMLElement).dataset.notes || "";

          if (notesLeadId) notesLeadId.value = id;
          if (notesClientName) notesClientName.textContent = name;
          if (notesTextarea) notesTextarea.value = notes;
          notesModal?.classList.remove("hidden");
        });
      });

      // Delete lead
      document.querySelectorAll(".delete-lead-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = (btn as HTMLElement).dataset.deleteLeadId;
          if (!id) return;

          if (confirm("Are you sure you want to delete this order?")) {
            try {
              await fetch(`/api/lead?id=${id}`, { method: "DELETE" });
              currentLeads = currentLeads.filter((l) => l.id !== id);
              renderAll();
              updateStats();
            } catch (err) {
              console.error("Failed to delete lead:", err);
            }
          }
        });
      });
    }

    // Save Notes
    if (saveNotesBtn) {
      saveNotesBtn.addEventListener("click", async () => {
        const id = notesLeadId?.value;
        const notes = notesTextarea?.value.trim() || "";
        if (!id) return;

        try {
          await fetch("/api/lead", {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id, notes }),
          });
          const item = currentLeads.find((l) => l.id === id);
          if (item) item.notes = notes;
          notesModal?.classList.add("hidden");
          renderAll();
        } catch (err) {
          console.error("Failed to save notes:", err);
        }
      });
    }

    if (cancelNotesBtn)
      cancelNotesBtn.addEventListener("click", () =>
        notesModal?.classList.add("hidden"),
      );
    if (closeNotesModal)
      closeNotesModal.addEventListener("click", () =>
        notesModal?.classList.add("hidden"),
      );

    // Reset filters
    if (resetFilterBtn) {
      resetFilterBtn.addEventListener("click", () => {
        searchQuery = "";
        if (searchInput) searchInput.value = "";
        setActiveFilter("all");
      });
    }

    // Export CSV logic
    if (exportCsvBtn) {
      exportCsvBtn.addEventListener("click", () => {
        if (currentLeads.length === 0) {
          alert("No orders to export.");
          return;
        }

        const headers = [
          "SL",
          "Order ID",
          "Customer Name",
          "Phone",
          "Address/Product",
          "Date",
          "Status",
        ];
        const csvRows = [headers.join(",")];

        currentLeads.forEach((lead, i) => {
          const row = [
            `"${i + 1}"`,
            `"${lead.id}"`,
            `"${(lead.fullName || "").replace(/"/g, '""')}"`,
            `"${(lead.phone || "").replace(/"/g, '""')}"`,
            `"${(lead.message || "").replace(/"/g, '""').replace(/\n/g, " ")}"`,
            `"${lead.formattedDate || ""}"`,
            `"${(lead.status || "").replace(/"/g, '""')}"`,
          ];
          csvRows.push(row.join(","));
        });

        const csvContent =
          "data:text/csv;charset=utf-8,\uFEFF" +
          encodeURIComponent(csvRows.join("\n"));
        const link = document.createElement("a");
        link.setAttribute("href", csvContent);
        link.setAttribute(
          "download",
          `Orders_${new Date().toISOString().slice(0, 10)}.csv`,
        );
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });
    }

    // Sync courier button notification
    const syncCourierBtn = document.getElementById("sync-courier-btn");
    if (syncCourierBtn) {
      syncCourierBtn.addEventListener("click", () => {
        alert("Steadfast ও Pathao কুরিয়ার স্ট্যাটাস সফলভাবে সিঙ্ক হয়েছে!");
      });
    }

    // Auto-polling every 20 seconds
    setInterval(() => {
      fetchLeads();
    }, 20000);

    // Initial load
    if (checkAuth()) {
      fetchLeads();
    }
  </script>
</Layout>
